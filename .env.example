# DriverGuard AI - Environment Variables
# Copy this file to .env and fill in your keys

# Google Gemini API Key for AI Safety Reports and Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: LangChain Tracing / Project config if using LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=driverguard-ai

# App Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO
